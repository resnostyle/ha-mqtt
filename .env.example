# Home Assistant
HA_URL=http://192.168.2.132:8123
HA_TOKEN=replace-with-long-lived-access-token

# One or more weather entities: name:entity_id,name:entity_id
# Topics become home/weather/<name>/{current,daily,hourly,5day}
HA_WEATHER_SOURCES=pirate:weather.pirateweather,metno:weather.forecast_home
# Legacy single-entity fallback (used only if HA_WEATHER_SOURCES is empty):
# HA_WEATHER_ENTITY=weather.pirateweather

# Mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/weather
MQTT_CLIENT_ID=weather-mqtt
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant

# Sun / day context (sun.sun → home/sun/current)
SUN_ENABLED=true
HA_SUN_ENTITY=sun.sun
MQTT_SUN_TOPIC_PREFIX=home/sun

# Units advertised in MQTT discovery (match your HA weather units)
TEMPERATURE_UNIT=°F
PRESSURE_UNIT=inHg
WIND_SPEED_UNIT=mph
VISIBILITY_UNIT=mi

# Polling
POLL_INTERVAL_SECONDS=900
HOURLY_FORECAST_HOURS=48
LOG_LEVEL=INFO

# Optional pinger settings (mise run pinger loads this same .env;
# MQTT topic/client for ping are set by the mise task, not these weather values)
# PING_INTERVAL_SECONDS=60
# PING_DISCOVERY_REFRESH_SECONDS=300
# PING_METHOD=tcp8008
# PING_TIMEOUT_MS=2000
# PING_TCP_PORT=8008
# PING_STATS_WINDOW=60
# PING_MANUFACTURER_FILTER=Google Inc.
# PING_EXCLUDE_MODELS=Google Cast Group
# PING_HOST_OVERRIDES=

# Optional monitor settings (mise run monitor loads this same .env;
# MQTT topic/client for monitor are set by the mise task)
# MONITOR_HOSTS=router:192.168.1.1,nas:192.168.1.50
# MONITOR_INTERVAL_SECONDS=60
# MONITOR_METHOD=icmp
# MONITOR_TIMEOUT_MS=2000
# MONITOR_TCP_PORT=443
# MONITOR_STATS_WINDOW=60
# Dedicated Docker/K8s env: see .env.monitor.example

# Optional speedtest settings (mise run speedtest loads this same .env;
# MQTT topic/client for speedtest are set by the mise task)
# SPEEDTEST_INTERVAL_SECONDS=3600
# SPEEDTEST_SERVER_ID=
# Dedicated Docker/K8s env: see .env.speedtest.example

