# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /pinger ./cmd/pinger

FROM alpine:3.21
RUN apk add --no-cache ca-certificates iputils
COPY --from=build /pinger /pinger
ENTRYPOINT ["/pinger"]
