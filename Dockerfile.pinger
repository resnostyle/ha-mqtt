# syntax=docker/dockerfile:1

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /pinger ./cmd/pinger

FROM alpine:3.24
RUN apk add --no-cache ca-certificates iputils
COPY --from=build /pinger /pinger
ENTRYPOINT ["/pinger"]
